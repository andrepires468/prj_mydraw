APP_NAME=mydraw
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack

DB_CONNECTION=mysql
# Docker Compose (raiz): use DB_HOST=mysql na rede interna — definido pelo `.env` da raiz injetado no container.
# PHP/Artisan **no host** contra MySQL do compose: DB_HOST=127.0.0.1 e DB_PORT=33306 (ou MYSQL_PORT do `.env` raiz).
DB_HOST=127.0.0.1
DB_PORT=33306
DB_DATABASE=mydraw
DB_USERNAME=mydraw
DB_PASSWORD=mydraw

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# JWT
# TTL em minutos. 129600 = 90 dias (~3 meses).
JWT_SECRET=
JWT_TTL=129600
JWT_REFRESH_TTL=129600

# MinIO externo (opcional — referência; o Laravel usa AWS_* e MINIO_PUBLIC_URL)
MINIO_SERVER_URL=https://seu-minio.exemplo.com
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Object storage — S3-compatível (MinIO local ou remoto)
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mydraw-drawings
# URL base da API S3 (ex.: https://minio.seudominio.com ou http://minio:9000 no Docker interno)
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Timeouts do cliente S3 em segundos
AWS_CONNECT_TIMEOUT=5
AWS_TIMEOUT=30
# Verificação TLS (true | false | caminho/para/ca.pem). Use false para certs self-signed.
AWS_VERIFY_SSL=true

# URL pública para montar links dos arquivos (acessível pelo navegador)
MINIO_PUBLIC_URL=

# Se o bucket do MinIO estiver com policy pública (download anônimo), defina true.
# Quando false (default), o backend gera URLs pré-assinadas temporárias para cada imagem.
MINIO_BUCKET_PUBLIC=false
# Minutos de validade das URLs pré-assinadas (apenas quando MINIO_BUCKET_PUBLIC=false).
MINIO_URL_TTL_MINUTES=60

# Google Sign-In — Web Client ID (mesmo valor que APP_VITE_GOOGLE_CLIENT_ID na raiz).
GOOGLE_CLIENT_ID=

# Google Gemini — categorização de tags/classificação indicativa (API key em https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Modelo REST em `models/{GEMINI_MODEL}:generateContent` (ex.: gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash
# Em HTTP 429 (cota/rate limit), quantas tentativas no total; espera Retry-After ou "retry in Xs" entre elas.
GEMINI_429_MAX_ATTEMPTS=5
# Tempo máximo (segundos) aguardando resposta do Gemini por chamada (default client). Padrão: 240.
GEMINI_REQUEST_TIMEOUT_SECONDS=240
# Timeout por imagem na categorização multi-imagem (mais curto). Padrão: 60.
GEMINI_CATEGORIZE_IMAGE_TIMEOUT_SECONDS=60
# Sleep em segundos entre chamadas Gemini no mesmo post (reduz 429). Padrão: 4.
GEMINI_REQUEST_SLEEP_SECONDS=4
# false desliga categorização IA (tags/rating); extração de metadados SD continua disponível.
AI_CATEGORIZATION_ENABLED=true

# Ollama local (Windows host, acessível do Docker via host.docker.internal).
# true = usar Ollama em vez do Gemini para categorização.
OLLAMA_PREFER=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=240
# Sleep entre calls Ollama (local; padrão 0).
OLLAMA_REQUEST_SLEEP_SECONDS=0
