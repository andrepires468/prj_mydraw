# ==============================================================================
# mydraw — variáveis de ambiente compartilhadas (docker compose)
# Copie este arquivo para `.env` e ajuste conforme necessário.
# ==============================================================================

COMPOSE_PROJECT_NAME=mydraw

# Perfis ativos em `docker compose up` (ex.: `docker compose up -d --build`).
# - `local-storage` — MinIO em container (deixe fora se usar só MinIO remoto em MINIO_API_URL).
# - `local-db` — MySQL 8 em container para desenvolvimento local.
COMPOSE_PROFILES=local-storage,local-db

# ---- Portas expostas no host ---------------------------------------------------
API_PORT=8088
APP_PORT=5173
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
# MySQL local (host): DataGrip / mysql CLI no host — use esta porta (mapeamento 33306→3306 no container).
MYSQL_PORT=33306

# ---- Banco de dados -----------------------------------------------------------
# Com o profile `local-db` ativo: use `DB_HOST=mysql` e `DB_PORT=3306` (rede Docker; a API fala com o serviço `mysql`).
# Banco remoto (Easypanel, etc.): remova `local-db` de COMPOSE_PROFILES e preencha host/porta remotos.
# Credenciais abaixo alimentam o container MySQL (MYSQL_*) e a API (`DB_*`).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mydraw
DB_USERNAME=mydraw
DB_PASSWORD=mydraw

# Root do MySQL local (só usado pelo serviço `mysql` no compose).
MYSQL_ROOT_PASSWORD=mydraw_root

# ---- MinIO (object storage) ---------------------------------------------------
# Os serviços `minio` e `createbuckets` estão sob o profile `local-storage`.
# Com `COMPOSE_PROFILES=local-storage` (recomendado no dev), o compose já sobe o MinIO local.
#
# - MinIO local: `COMPOSE_PROFILES=local-storage`, `MINIO_API_URL` vazio,
#   `APP_VITE_MINIO_PUBLIC_URL=http://localhost:9100`.
#
# - MinIO remoto apenas: remova `COMPOSE_PROFILES` ou não inclua `local-storage`;
#   defina `MINIO_API_URL` e `APP_VITE_MINIO_PUBLIC_URL` para o endpoint público.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mydraw-drawings
MINIO_REGION=us-east-1

# Endpoint S3 usado pelo **container da API** para o SDK (rede Docker).
# Deixe vazio para o compose usar `http://minio:9000` (serviço local).
# Remoto: URL HTTPS do MinIO. Nunca `http://localhost:9100` aqui — no container localhost ≠ MinIO.
MINIO_API_URL=

# `true`: API monta URLs `APP_VITE_MINIO_PUBLIC_URL/bucket/key` (bucket com policy pública; típico no dev local).
# `false`: URLs pré-assinadas (host do endpoint precisa ser acessível ao browser — use MinIO remoto com HTTPS).
MINIO_BUCKET_PUBLIC=true

# Verificação de SSL para o endpoint S3. Em remoto com cert válido: true.
# Para MinIO local (HTTP) pode deixar true; só desligue se precisar.
AWS_VERIFY_SSL=true

# ---- API (Lumen) --------------------------------------------------------------
API_APP_ENV=local
API_APP_DEBUG=true
API_APP_KEY=base64:CHANGE_ME_AFTER_INIT
API_JWT_SECRET=CHANGE_ME_AFTER_INIT
# TTL do JWT em minutos. 129600 = 90 dias (~3 meses).
API_JWT_TTL=129600
API_JWT_REFRESH_TTL=129600
API_APP_URL=http://localhost:8088

# TTL (segundos) da resposta cacheada de GET /api/v1/posts. 0 desativa o cache em arquivo.
POSTS_LIST_CACHE_TTL_SECONDS=15

# Civitai — opcional; usado para enriquecer LoRAs (criador/link) por hash ao extrair metadados das imagens.
# Gere um token em https://developer.civitai.com (conta Civitai).
CIVITAI_API_TOKEN=

# Google Gemini — categorização de tags/classificação indicativa (API key em https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Modelo REST em `models/{GEMINI_MODEL}:generateContent` (ex.: gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash
# Em HTTP 429 (cota/rate limit), quantas tentativas no total; espera Retry-After ou "retry in Xs" entre elas.
GEMINI_429_MAX_ATTEMPTS=5
# Tempo máximo (segundos) aguardando resposta do Gemini por chamada (default client). Padrão: 240.
GEMINI_REQUEST_TIMEOUT_SECONDS=240
# Timeout por imagem na categorização multi-imagem (mais curto). Padrão: 60.
GEMINI_CATEGORIZE_IMAGE_TIMEOUT_SECONDS=60
# Sleep em segundos entre chamadas Gemini no mesmo post (reduz 429). Padrão: 4.
GEMINI_REQUEST_SLEEP_SECONDS=4
# false desliga categorização IA (tags/rating); extração de metadados SD continua disponível.
AI_CATEGORIZATION_ENABLED=true

# Ollama local (Windows host, acessível do Docker via host.docker.internal).
# true = usar Ollama em vez do Gemini para categorização.
OLLAMA_PREFER=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=240
# Sleep entre calls Ollama (local; padrão 0).
OLLAMA_REQUEST_SLEEP_SECONDS=0

# ---- APP (Vue 3) — Compose injeta como VITE_* no container app (única fonte; sem .env em apps/mydraw_app)
# Rede local (celular/outro PC): pode manter localhost aqui — em dev o app troca o host
# da API para o mesmo da barra de endereço; a API (APP_ENV=local) alinha URLs do MinIO ao header Origin.
APP_VITE_API_URL=http://localhost:8088
APP_VITE_API_VERSION=v1
APP_VITE_MINIO_PUBLIC_URL=http://localhost:9100

# MinIO na LAN para Capacitor/celular (APP_ENV=local). Mesmo IP/porta expostos no host.
# MINIO_PUBLIC_LAN_URL=http://192.168.86.122:9100

# ---- Google Sign-In (GIS) — mesmo Web Client ID na API (audience do ID Token) e no app (VITE_*).
GOOGLE_CLIENT_ID=
APP_VITE_GOOGLE_CLIENT_ID=

# ---- CORS (API) ---------------------------------------------------------------
# Origens permitidas (produção). Separadas por vírgula. Inclua domínio web e Capacitor se necessário.
# Ex.: https://app.seudominio.com,capacitor://localhost,http://localhost
# Em APP_ENV=local, origens não listadas ainda são aceitas (dev LAN/Vite).
CORS_ALLOWED_ORIGINS=
# URL pública do frontend (opcional; incluída na allowlist padrão se definida).
FRONTEND_URL=

# ---- Backup (scripts/backup-storage.sh) — upload MEGA opcional (MEGAcmd: https://mega.nz/cmd)
# Após upload com sucesso, os ZIPs deste run são apagados localmente (permanecem só no MEGA).
# O script também empacota todos os .env* do repo (exc. backup/, node_modules, vendor, .git).
# MEGA_REMOTE_DIR=/Backups/mydraw
# MEGA_EMAIL=
# MEGA_PASSWORD=
# Dias retidos no MEGA e localmente (ZIPs antigos). 0 = não remove remotamente / não expira no MEGA.
# MEGA_KEEP_DAYS=30
# KEEP_DAYS=30
