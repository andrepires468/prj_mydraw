{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:mobile": "vue-tsc -b && vite build --mode mobile",
    "sync:android": "npm run build:mobile && cap sync android",
    "android:sha1": "cd android && ./gradlew signingReport",
    "dev:android": "CAP_USE_LIVE_RELOAD=true cap sync android && cap run android -l --external",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:run:android": "npm run sync:android && cap run android",
    "cap:run:ios": "npm run build:mobile && cap sync ios && cap run ios",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "axios": "^1.15.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vue-tsc": "^3.2.6"
  }
}
