# ==============================================================================
# mydraw — variáveis de ambiente compartilhadas (docker compose)
# Copie este arquivo para `.env` e ajuste conforme necessário.
# ==============================================================================

COMPOSE_PROJECT_NAME=mydraw

# ---- Portas expostas no host ---------------------------------------------------
API_PORT=8088
APP_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Banco de dados (externo) -------------------------------------------------
# O projeto consome um MySQL externo; não há serviço MySQL no docker-compose.
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=mydraw
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ---- MinIO (object storage) ---------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mydraw-drawings
MINIO_REGION=us-east-1

# ---- API (Lumen) --------------------------------------------------------------
API_APP_ENV=local
API_APP_DEBUG=true
API_APP_KEY=base64:CHANGE_ME_AFTER_INIT
API_JWT_SECRET=CHANGE_ME_AFTER_INIT
# TTL do JWT em minutos. 129600 = 90 dias (~3 meses).
API_JWT_TTL=129600
API_JWT_REFRESH_TTL=129600
API_APP_URL=http://localhost:8088

# ---- APP (Vue 3) — expostas via VITE_* ----------------------------------------
APP_VITE_API_URL=http://localhost:8088
APP_VITE_MINIO_PUBLIC_URL=http://localhost:9000
